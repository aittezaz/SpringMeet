# ═══════════════════════════════════════════════════════════════
# SpringMeet Backend Environment Variables
# 
# For Docker Compose deployment, these are overridden by root .env
# For local development, copy to backend/.env and configure locally
# ═══════════════════════════════════════════════════════════════

# ── Node Environment ──
# development | production
NODE_ENV=production
# API port
PORT=4000
# Frontend URL for CORS
FRONTEND_URL=https://yourdomain.com

# ── Database (PostgreSQL) ──
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Docker Compose: postgres:5432 (service name)
# Local dev: localhost:5432
# Production: your-db-host:5432
DATABASE_URL=postgresql://springmeet_user:CHANGE_PASSWORD@postgres:5432/springmeet_db

# ── Redis ──
# Docker Compose: redis (service name)
# Local dev: localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_PASSWORD

# ── JWT Authentication ──
# Generate: openssl rand -hex 64
# Keep these VERY secure and never expose!
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_HEX_STRING

# ── Email (SMTP) ──
# Gmail: smtp.gmail.com:587
# Get App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD

# ── Logging ──
# debug | info | warn | error
LOG_LEVEL=info

# ── Optional Features ──

# OpenAI for content moderation
# OPENAI_API_KEY=sk-...

# Stripe for premium features
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# AWS S3 for profile images
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=springmeet-avatars
# AWS_REGION=us-east-1
