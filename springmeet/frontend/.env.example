# ═══════════════════════════════════════════════════════════════
# SpringMeet Frontend Environment Variables
# 
# These MUST start with NEXT_PUBLIC_ to be available in the browser!
# Copy to frontend/.env.local for local development
# For Docker Compose, these are set in the build args from root .env
# ═══════════════════════════════════════════════════════════════

# Backend API URL
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# WebSocket URL (usually same as API)
NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com

# Frontend app URL (for email links, etc.)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# App branding (optional)
NEXT_PUBLIC_APP_NAME=SpringMeet
