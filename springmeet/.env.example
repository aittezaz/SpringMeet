# ═══════════════════════════════════════════════════════════════
# SpringMeet Production Environment Variables
# 
# IMPORTANT: Copy this to .env and fill in ALL values before deploying!
# See DEPLOYMENT.md for complete setup instructions.
# ═══════════════════════════════════════════════════════════════

# ── Database ──
# Default username
POSTGRES_USER=springmeet_user
# Change this! Generate: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD
# Database name
POSTGRES_DB=springmeet_db

# ── Redis ──
# Change this! Generate: openssl rand -hex 16
REDIS_PASSWORD=CHANGE_THIS_STRONG_REDIS_PASSWORD

# ── JWT Authentication ──
# Generate: openssl rand -hex 64
# These MUST be different values!
JWT_SECRET=GENERATE_64_CHAR_RANDOM_HEX_HERE
JWT_REFRESH_SECRET=GENERATE_ANOTHER_64_CHAR_RANDOM_HEX_HERE

# ── Email Notifications ──
# Get App Password: https://myaccount.google.com/apppasswords
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select Mail → Other (custom) → SpringMeet
# 3. Copy the 16-character password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD_HERE

# ── Frontend URLs ──
# Replace yourdomain.com with your actual domain
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Optional Features (comment out if not using) ──
# AI Moderation via OpenAI
# OPENAI_API_KEY=sk-...

# Stripe for premium features
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# AWS S3 for user profile images
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=springmeet-avatars
# AWS_REGION=us-east-1
